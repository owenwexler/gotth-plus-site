package view

import (
	"github.com/owenwexler/gotth-plus-site/internal/docs"
	"github.com/owenwexler/gotth-plus-site/internal/styles"
)

templ ErrorPage() {
	<div class="flex flex-col items-center justify-center space-y-2 m-2">
		@ErrorText()
		@ResetButton()
	</div>
}

templ NotFoundPage() {
	@Layout("Page not found · GOTTH+", "This page does not exist.") {
		@Header()
		<main class="mx-auto flex min-h-[60vh] max-w-3xl flex-col items-center justify-center gap-6 px-5 py-16 text-center">
			<p class="text-xs font-medium tracking-[0.18em] text-neutral-400 uppercase">404</p>
			<h1 class="text-4xl font-semibold tracking-tight">This page doesn’t exist.</h1>
			@ButtonLink("/", "Back home")
		</main>
	}
}

// Home is the landing page: what the stack is, a live project-command builder, and what it gives you.
templ Home() {
	@Layout("GOTTH+ · Go, Templ, Tailwind and HTMX", "GOTTH+ is an opinionated, secure starting point for server-rendered Go web apps: Go, Templ, Tailwind CSS and htmx, with a little Alpine.js.") {
		@Header()
		<main class="mx-auto flex max-w-5xl flex-col items-center gap-16 px-5 py-12 sm:gap-24 sm:px-8 sm:py-20">
			@Hero()
			@TryIt()
			@Features()
			@BuiltWithItself()
		</main>
		@Footer()
	}
}

templ Hero() {
	<section class="flex max-w-2xl flex-col items-center gap-6 text-center" aria-labelledby="hero-title">
		<h1 id="hero-title" class="text-7xl font-semibold tracking-tighter sm:text-9xl">GOTTH<span class="text-neutral-400">+</span></h1>
		<p class="max-w-lg text-lg leading-relaxed text-neutral-200 sm:text-xl">Go, Templ, Tailwind and HTMX, ready for production.</p>
		<p class="max-w-xl text-sm leading-relaxed text-neutral-400">A secure, opinionated starting point for server-rendered web apps. No Node, no npm and no bundler. The server owns the state and sends HTML; the browser does only what HTML cannot.</p>
		<div class="flex w-full flex-col gap-3 pt-2 sm:w-auto sm:flex-row">
			@ButtonLink("/docs/getting-started", "Get started")
			@ButtonLink("/docs", "Read the docs")
		</div>
	</section>
}

// TryIt is a real htmx round trip: the server validates the choices and returns the command.
templ TryIt() {
	<section id="try" class={ styles.GenerateCardClasses() } aria-labelledby="try-title">
		<p class="text-xs font-medium tracking-[0.18em] text-neutral-400 uppercase">Try it / Server interaction</p>
		<h2 id="try-title" class="text-3xl font-semibold tracking-tight">Start a project in one command</h2>
		<p class="text-sm leading-relaxed text-neutral-300">Choose a name and a database. The server checks your choices and returns the command that creates the project with create-gotth-plus-app.</p>
		<form
			class={ styles.GenerateHorizontalFormClasses() }
			hx-post="/try/command"
			hx-target="#command-result"
			hx-swap="outerHTML"
			hx-trigger="submit"
			hx-disabled-elt="find button"
			hx-indicator="find button"
		>
			<label for="project-name" class="sr-only">Project name</label>
			<input
				type="text"
				id="project-name"
				name="name"
				placeholder="my-app"
				maxlength="40"
				autocomplete="off"
				class={ styles.GenerateInputClasses() }
			/>
			<label for="project-database" class="sr-only">Database</label>
			<select id="project-database" name="database" class={ styles.GenerateInputClasses() }>
				<option value="sqlite">SQLite</option>
				<option value="postgres">Postgres</option>
				<option value="mysql">MySQL</option>
			</select>
			<button type="submit" class={ styles.GenerateBigButtonClasses(), "relative" }>
				<!-- The label stays in the flow (invisible while loading) so the button doesn't resize -->
				<span class="[.htmx-request_&]:invisible">Build command</span>
				<span aria-hidden="true" class="htmx-indicator absolute inset-0 flex items-center justify-center">
					@Spinner(16, 16)
				</span>
			</button>
		</form>
		@CommandResult("")
	</section>
}

templ Features() {
	<section class="grid w-full grid-cols-1 gap-5 sm:grid-cols-2 md:gap-6" aria-label="What you get">
		@FeatureCard("01 / Server", "Plain Go, no framework", "net/http with Go 1.22 routing, server timeouts, graceful shutdown and structured logs that carry a request ID.")
		@FeatureCard("02 / Views", "Type-safe HTML", "Templ components are compiled Go. Output is escaped by context, so hostile input is shown as text, never run.")
		@FeatureCard("03 / Interaction", "htmx first", "Forms and navigation swap fragments from the server. Failures show a toast, never silence, and links preload on hover.")
		@FeatureCard("04 / Client state", "A little Alpine", "Alpine's CSP build keeps client-only state, such as a copy button, without eval or inline scripts.")
		@FeatureCard("05 / Security", "Secure by default", "A strict Content-Security-Policy, CSRF tokens, cross-origin checks, per-client rate limits and body caps, with HSTS in production.")
		@FeatureCard("06 / Quality", "Tested at every layer", "Unit tests, integration tests through the real middleware, and browser tests for focus rings, toasts, phone layouts and the site's own flows.")
	</section>
}

templ FeatureCard(kicker string, title string, body string) {
	<article class={ styles.GenerateCardClasses() }>
		<p class="text-xs font-medium tracking-[0.18em] text-neutral-400 uppercase">{ kicker }</p>
		<h3 class="text-2xl font-semibold tracking-tight">{ title }</h3>
		<p class="text-sm leading-relaxed text-neutral-300">{ body }</p>
	</article>
}

// BuiltWithItself says which parts of the stack this site uses, and where.
templ BuiltWithItself() {
	<section class="w-full space-y-6" aria-labelledby="built-title">
		<div class="max-w-2xl space-y-3">
			<h2 id="built-title" class="text-3xl font-semibold tracking-tight">Built with GOTTH+, and running on it</h2>
			<p class="text-sm leading-relaxed text-neutral-300">This site is built with the stack it describes. Nothing here is a static export: the Go server renders every page, and the command builder and the feedback vote are live.</p>
		</div>
		<dl class="grid grid-cols-1 gap-x-8 gap-y-4 text-sm sm:grid-cols-2">
			<div class="border-t border-white/15 pt-4"><dt class="font-medium text-white">Go</dt><dd class="text-neutral-300">Routes, handlers and the middleware chain.</dd></div>
			<div class="border-t border-white/15 pt-4"><dt class="font-medium text-white">Templ</dt><dd class="text-neutral-300">Every page, section and fragment on this site.</dd></div>
			<div class="border-t border-white/15 pt-4"><dt class="font-medium text-white">htmx</dt><dd class="text-neutral-300">The command builder, the feedback vote and boosted navigation.</dd></div>
			<div class="border-t border-white/15 pt-4"><dt class="font-medium text-white">Alpine.js</dt><dd class="text-neutral-300">The copy button and the mobile docs menu.</dd></div>
			<div class="border-t border-white/15 pt-4"><dt class="font-medium text-white">Tailwind CSS</dt><dd class="text-neutral-300">The styles, built by the standalone CLI.</dd></div>
			<div class="border-t border-white/15 pt-4"><dt class="font-medium text-white">SQLite and GORM</dt><dd class="text-neutral-300">Vote counts on each docs page, migrated by cmd/migrate.</dd></div>
		</dl>
	</section>
}

templ Footer() {
	<footer class="border-t border-white/10 px-5 py-8 text-center text-xs tracking-wide text-neutral-400 sm:px-8">
		<p>
			GOTTH+ is open source.
			<a class="underline underline-offset-4 hover:text-white" href="https://github.com/owenwexler/gotth-plus" target="_blank" rel="noopener noreferrer">gotth-plus on GitHub</a>
			·
			<a class="underline underline-offset-4 hover:text-white" href="https://github.com/owenwexler/create-gotth-plus-app" target="_blank" rel="noopener noreferrer">create-gotth-plus-app on GitHub</a>
			·
			<a class="underline underline-offset-4 hover:text-white" href="/docs">Docs</a>
			·
			<a class="underline underline-offset-4 hover:text-white" href="/docs/deployment">Deployment</a>
		</p>
		<p class="mt-3">This open-source library is presented as-is with no additional warranty whether express or implied.</p>
	</footer>
}

// DocsIndex lists every page, grouped as the navigation groups them.
templ DocsIndex(groups []docs.Group) {
	@Layout("Documentation · GOTTH+", "Guides for building, testing, securing and deploying a GOTTH+ app.") {
		@Header()
		<main class="mx-auto flex max-w-5xl flex-col gap-12 px-5 py-12 sm:px-8 sm:py-16">
			<header class="max-w-2xl space-y-4">
				<h1 class="text-5xl font-semibold tracking-tighter sm:text-6xl">Documentation</h1>
				<p class="text-lg leading-relaxed text-neutral-200">Everything in GOTTH+ and create-gotth-plus-app, from the first command to a production deploy. The facts here come from the template's README, SECURITY.md and AGENTS.md.</p>
			</header>
			for _, g := range groups {
				<section class="space-y-5" aria-label={ g.Title }>
					<h2 class="text-xs font-medium tracking-[0.18em] text-neutral-400 uppercase">{ g.Title }</h2>
					<ul class="grid grid-cols-1 gap-4 md:grid-cols-2">
						for _, d := range g.Docs {
							<li>
								<a href={ templ.URL("/docs/" + d.Slug) } class={ styles.GenerateCardClasses(), "h-full no-underline hover:border-white/30 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white" }>
									<h3 class="text-xl font-semibold tracking-tight">{ d.Title }</h3>
									<p class="text-sm leading-relaxed text-neutral-300">{ d.Summary }</p>
								</a>
							</li>
						}
					</ul>
				</section>
			}
		</main>
		@Footer()
	}
}
