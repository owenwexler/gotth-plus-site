# Copy to .env for local development. In production, set these in the platform's environment instead.

# "development" or "production". Production turns on HSTS, Secure cookies, JSON logs and strict
# rate limits.
GoEnv=development

Port=3000

# Optional. SQLite database file; defaults to app.db.
DatabasePath=app.db

# Optional. Networks of the reverse proxies in front of the app, comma-separated CIDRs or addresses.
# Set it when a proxy terminates TLS, so each visitor is rate limited on their own (DEPLOYMENT.md).
# Leave it empty when nothing is in front of the app.
# TrustedProxies=127.0.0.1/32
